{
  "schemaVersion": 1,
  "fixtureCanary": "p3b-ts04-local-ledger-reliability",
  "timeoutMs": 30000,
  "terminationGraceMs": 1000,
  "limits": {
    "maxMessageBytes": 4096,
    "maxOutputBytes": 8192,
    "maxReasonLength": 512,
    "maxWorkers": 2,
    "maxCrashCases": 22,
