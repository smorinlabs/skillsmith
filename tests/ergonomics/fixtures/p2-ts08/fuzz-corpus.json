        "to": "    \"kind\": \"portable\",\n    \"unknown\": true,\n    \"reasons\": []"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "plan-truncated-json",
      "artifact": "plan",
      "codecVersion": 1,
      "source": "plan-v1.golden.json",
      "mutation": {
        "kind": "truncate-bytes",
        "count": 2
