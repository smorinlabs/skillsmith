{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "manifest-future-version",
      "artifact": "manifest",
      "codecVersion": 1,
      "source": "manifest-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "version = 1\n\n[defaults]",
        "to": "version = 2\n\n[defaults]"
      },
      "expectedReason": "unsupported-version"
    },
    {
      "id": "manifest-zero-version",
      "artifact": "manifest",
      "codecVersion": 1,
      "source": "manifest-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "version = 1\n\n[defaults]",
        "to": "version = 0\n\n[defaults]"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "manifest-unknown-root",
      "artifact": "manifest",
      "codecVersion": 1,
      "source": "manifest-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "version = 1\n\n[defaults]",
        "to": "version = 1\nunknown = true\n\n[defaults]"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "manifest-unknown-nested-default",
      "artifact": "manifest",
      "codecVersion": 1,
      "source": "manifest-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "[defaults]\ntools = [\"claude-code\", \"codex\"]",
        "to": "[defaults]\nunknown = true\ntools = [\"claude-code\", \"codex\"]"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "manifest-truncated-table",
      "artifact": "manifest",
      "codecVersion": 1,
      "literalUtf8": "version = 1\n[defaults\n",
      "expectedReason": "malformed"
    },
    {
      "id": "manifest-invalid-utf8",
      "artifact": "manifest",
      "codecVersion": 1,
      "literalHex": "ff",
      "expectedReason": "malformed"
    },
    {
      "id": "lock-future-version",
      "artifact": "lock",
      "codecVersion": 1,
      "source": "lock-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "version = 1\nhash_schema_version = 1",
        "to": "version = 2\nhash_schema_version = 1"
      },
      "expectedReason": "unsupported-version"
    },
    {
      "id": "lock-zero-version",
      "artifact": "lock",
      "codecVersion": 1,
      "source": "lock-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "version = 1\nhash_schema_version = 1",
        "to": "version = 0\nhash_schema_version = 1"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "lock-unknown-root",
      "artifact": "lock",
      "codecVersion": 1,
      "source": "lock-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "version = 1\nhash_schema_version = 1",
        "to": "version = 1\nunknown = true\nhash_schema_version = 1"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "lock-unknown-nested-skill",
      "artifact": "lock",
      "codecVersion": 1,
      "source": "lock-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "name = \"lint\"\nsource = \"github.com/acme/skills//skills/lint\"",
        "to": "name = \"lint\"\nunknown = true\nsource = \"github.com/acme/skills//skills/lint\""
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "lock-noncanonical-missing-lf",
      "artifact": "lock",
      "codecVersion": 1,
      "source": "lock-v1.golden.toml",
      "mutation": {
        "kind": "truncate-bytes",
        "count": 1
      },
      "expectedReason": "noncanonical"
    },
    {
      "id": "lock-noncanonical-key-order",
      "artifact": "lock",
      "codecVersion": 1,
      "source": "lock-v1.golden.toml",
      "mutation": {
        "kind": "replace-once",
        "from": "version = 1\nhash_schema_version = 1",
        "to": "hash_schema_version = 1\nversion = 1"
      },
      "expectedReason": "noncanonical"
    },
    {
      "id": "plan-future-version",
      "artifact": "plan",
      "codecVersion": 1,
      "source": "plan-v1.golden.json",
      "mutation": {
        "kind": "replace-once",
        "from": "\"schemaVersion\": 1",
