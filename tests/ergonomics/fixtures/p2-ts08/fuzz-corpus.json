      "id": "ledger-v2-private-nested-staging-path",
      "artifact": "ledger",
      "codecVersion": 2,
      "source": "ledger-v2.golden.json",
      "mutation": {
        "kind": "replace-once",
        "from": "      \"transactionId\": \"tx:migrate-ledger-live\",\n      \"intent\": {",
        "to": "      \"transactionId\": \"tx:migrate-ledger-live\",\n      \"stagingPath\": \"/fixture/private-stage\",\n      \"intent\": {"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "ledger-truncated-json",
      "artifact": "ledger",
      "codecVersion": 2,
      "source": "ledger-v2.golden.json",
      "mutation": {
        "kind": "truncate-bytes",
