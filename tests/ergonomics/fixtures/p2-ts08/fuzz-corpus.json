    {
      "id": "ledger-v1-unknown-nested-pair",
      "artifact": "ledger",
      "codecVersion": 1,
      "source": "ledger-v1.golden.json",
      "mutation": {
        "kind": "replace-once",
        "from": "          \"placementPath\": \"/home/fixture/.codex/skills/review\",",
        "to": "          \"placementPath\": \"/home/fixture/.codex/skills/review\",\n          \"unknown\": true,"
      },
      "expectedReason": "invalid-shape"
    },
    {
      "id": "ledger-future-version",
      "artifact": "ledger",
      "codecVersion": 2,
      "source": "ledger-v2.golden.json",
      "mutation": {
        "kind": "replace-once",
        "from": "{\n  \"schemaVersion\": 2,\n  \"kind\": \"skillsmith.placements\"",
        "to": "{\n  \"schemaVersion\": 3,\n  \"kind\": \"skillsmith.placements\""
      },
      "expectedReason": "unsupported-version"
    },
    {
      "id": "ledger-zero-version",
      "artifact": "ledger",
      "codecVersion": 2,
      "source": "ledger-v2.golden.json",
      "mutation": {
        "kind": "replace-once",
