{
  "schemaVersion": 1,
  "fixtureCanary": "p2-ts06-shape-contract-canary",
  "cases": [
    {
      "id": "canonical-minimal",
      "encoding": "utf8",
      "source": "version = 1\n",
      "signedShape": "canonical",
      "expected": {
        "state": "present",
        "sourceVersion": 1,
        "currentVersion": 1,
        "canonical": true,
        "migration": false
      }
    },
    {
      "id": "canonical-populated",
      "encoding": "utf8",
      "source": "version = 1\n\n[defaults]\ntools = [\"codex\", \"claude-code\"]\nscope = \"project\"\npath = \"./skills\"\n\n[registry]\ndefault = \"https://github.com/acme\"\n\n[[skills]]\nname = \"review\"\nsource = \"github.com/acme/tools//skills/review\"\nref = \"main\"\ntools = [\"opencode\", \"codex\"]\nscope = \"user\"\nplacement = \"copy\"\npath = \"~/review\"\n",
      "signedShape": "canonical",
      "expected": {
        "state": "present",
        "sourceVersion": 1,
        "currentVersion": 1,
        "canonical": false,
        "migration": false
      }
    },
    {
      "id": "canonical-human-crlf",
      "encoding": "utf8",
      "source": "# retained heading\r\nversion = 1\r\n",
      "signedShape": "canonical",
      "expected": {
        "state": "present",
        "sourceVersion": 1,
        "currentVersion": 1,
        "canonical": false,
        "migration": false
      }
    },
    {
