{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "files": {
    "ignore": ["dist/**", "node_modules/**", "*.tsbuildinfo", "packages/*/tests/fixtures/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error" },
      "style": { "useImportType": "error", "useNodejsImportProtocol": "error" },
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" }
    }
  },
  "overrides": [
    {
      "include": [
        "package.json",
        "packages/cli/package.json",
        "packages/core/package.json",
        ".release-please-manifest.json"
      ],
      "formatter": { "enabled": false }
    },
    {
      "include": [
        "tests/ergonomics/fixtures/p2-ts08/*.golden.json",
        "tests/ergonomics/fixtures/p3a-ts04/*.golden.json",
        "tests/ergonomics/fixtures/g3a02-contracts/*.golden.json",
        "tests/ergonomics/fixtures/p3a-ts01/*.golden.json"
      ],
      "formatter": { "enabled": false }
    }
  ]
}
