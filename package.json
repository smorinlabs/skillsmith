{
  "name": "skillsmith-workspace",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run packages/cli/src/index.ts",
    "test": "bun test",
    "test:terminal": "bun scripts/run-test-files-serial.ts",
    "test:smoke": "bun run test:smoke:p2-ts04",
    "test:smoke:p2-ts04": "bun test tests/ergonomics/phase/EWP-P2-TS04.test.ts --test-name-pattern 'fixtures are counted|spawn fixtures expose|publishes the closed types|pure and coordinated no-op|all nine real topology rows'",
    "test:smoke:p2-ts04:recovery": "bun test tests/ergonomics/phase/EWP-P2-TS04.test.ts --test-name-pattern 'discovers exact structured transcripts|serializes absent targets, lock overrides|executes collision retry|executes all eleven one-time replay'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:boundaries": "eslint 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "fmt": "biome check --write",
    "actions-lint": "actionlint",
    "check:p17": "bun scripts/check-p17-package.ts --pr-openable",
    "check": "just check",
    "build:darwin-arm64": "bun build --compile --bytecode --target=bun-darwin-arm64 packages/cli/src/index.ts --outfile dist/skillsmith",
    "build:darwin-x64": "bun build --compile --bytecode --target=bun-darwin-x64 packages/cli/src/index.ts --outfile dist/skillsmith",
    "build:linux-x64": "bun build --compile --bytecode --target=bun-linux-x64 packages/cli/src/index.ts --outfile dist/skillsmith",
    "build:linux-arm64": "bun build --compile --bytecode --target=bun-linux-arm64 packages/cli/src/index.ts --outfile dist/skillsmith",
    "build:release": "bun scripts/build-release.ts --target all",
    "build": "bun scripts/build-native.ts",
    "postinstall": "./scripts/install-hooks.sh"
  },
  "devDependencies": {
    "@skillsmith/core": "workspace:*",
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.0",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-security": "4.0.0",
    "lefthook": "1.13.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.6",
    "js-yaml": "^3.15.2"
  }
}
